# ============================================================
# Guardas de dado — a primeira coisa que nasce num harness.
# Perder dado ou vazar dado não tem desfazer, por isso estas
# linhas entram preventivamente (única exceção da Lei 1).
# ============================================================
{{DADOS_PROTEGIDOS}}

# Instrumentação do harness (local, não versionar)
.harness/log-guardas.jsonl
.harness/abatidos/
.harness/hibernado/

# A sombra — as fotos do projeto (máquina do tempo local).
# Fica FORA do git de propósito: é rede de segurança da máquina, não
# histórico do projeto. Versionar duplicaria tudo a cada commit.
.harness/sombra.git/
.harness/.sombra-ultima

# Lock files do Excel (arquivo aberto)
~$*.xlsx
**/~$*.xlsx

# Dependências e build
node_modules/
dist/
build/
__pycache__/
*.pyc

# Ambiente e segredos — NUNCA versionar
.env
.env.*
*.key
*.pem

# ...com UMA exceção: o modelo sem valor nenhum dentro.
#
# Sem esta linha, `.env.*` engole o próprio `.env.example` e ninguém — nem você
# numa máquina nova — descobre quais variáveis o projeto usa. Achado no Vórtex
# em 13/08/2026; a partir da v1.8.0 o `/harness doctor --skill` reprova o
# template que tiver `.env.*` sem esta exceção.
!.env.example

# Sistema operacional
Thumbs.db
.DS_Store
